rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profileValid(data) {
      return data.keys().hasOnly([
        'displayName',
        'grade',
        'curriculum',
        'language',
        'role',
        'createdAt',
        'updatedAt'
      ])
      && (!('displayName' in data) || data.displayName is string)
      && (!('grade' in data) || data.grade is string)
      && (!('curriculum' in data) || data.curriculum is string)
      && (!('language' in data) || data.language is string)
      && (!('role' in data) || data.role == 'student');
    }

    function validProgress(data) {
      return data.keys().hasOnly([
        'completedLessons',
        'xp',
        'streak',
        'lastActive',
        'quizResults',
        'updatedAt'
      ]);
    }

    function validPlanner(data) {
      return data.keys().hasOnly([
        'title',
        'subject',
        'date',
        'done',
        'createdAt',
        'updatedAt'
      ]);
    }

    function validFlashcard(data) {
      return data.keys().hasOnly([
        'front',
        'back',
        'subject',
        'createdAt',
        'updatedAt'
      ]);
    }

    match /users/{uid} {
      allow read: if owner(uid);

      allow create: if owner(uid)
        && profileValid(request.resource.data);

      allow update: if owner(uid)
        && profileValid(request.resource.data)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'grade',
            'curriculum',
            'language',
            'updatedAt'
          ]);

      allow delete: if false;

      match /progress/{docId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && validProgress(request.resource.data);
        allow delete: if owner(uid);
      }

      match /planner/{docId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && validPlanner(request.resource.data);
        allow delete: if owner(uid);
      }

      match /flashcards/{docId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && validFlashcard(request.resource.data);
        allow delete: if owner(uid);
      }

      match /revision/{docId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid);
        allow delete: if owner(uid);
      }

      match /projects/{docId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly([
            'title',
            'description',
            'code',
            'createdAt',
            'updatedAt'
          ]);
        allow delete: if owner(uid);
      }
    }

    match /aiRateLimits/{uid} {
      allow read, write: if false;
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.token.admin == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
